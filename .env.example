# Accounts (Firebase Authentication). Leave unset to run as a single local user.
# Project ID from Firebase console > Project settings.
FOOTAGE2ROBOT_FIREBASE_PROJECT=
# The web app's config object from Project settings > Your apps, as one line of JSON.
# These values are public identifiers, not secrets.
FOOTAGE2ROBOT_FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}
